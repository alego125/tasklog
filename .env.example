# PostgreSQL local: usar DATABASE_SSL=disable exclusivamente con localhost.
# Neon: se verifica TLS; los parámetros sslmode de la URL no desactivan esa verificación.
DATABASE_URL=postgresql://usuario:password@localhost:5432/tasklog
DATABASE_SSL=disable
# Para una CA privada, indicar su ruta sin desactivar la verificación:
# DATABASE_CA_FILE=/ruta/ca.pem
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://localhost:4173
# Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Obligatorio en producción (32 bytes mínimo). Vacío en desarrollo: clave efímera por arranque.
JWT_SECRET=
# Solo si hay un proxy conocido delante del backend. Render: 1. Local: 0.
TRUST_PROXY_HOPS=0
# Frontend desplegado en Vercel (variable definida durante el build):
# VITE_API_URL=https://tasklog-api.onrender.com
